# mcp-macos configuration. Copy to .env or set in your MCP client's `env` block.
# Everything defaults to the safest setting; raise privileges deliberately.

# ---- Access mode ----------------------------------------------------------
# read-only (default) → observe only. read-write → also write files, clipboard,
# notifications, open things. admin → also run_command/AppleScript, delete, kill,
# and drive the GUI. Tools above the mode are never registered.
MACOS_MODE=read-only

# ---- Filesystem scope -----------------------------------------------------
# Comma-separated absolute path roots the agent may touch. Empty = anywhere
# (protected paths below still block mutation). Supports ~ for home.
# MACOS_PATH_ALLOWLIST=~/Projects,~/Downloads
#
# Roots that may be READ but never written to or deleted. Defaults to a sensible
# system + secrets set (/System, /usr, /bin, /sbin, /private, /Library, ~/.ssh,
# ~/.aws, ~/.gnupg, ~/Library/Keychains). Override to replace the whole list.
# MACOS_PROTECTED_PATHS=/System,/usr,~/.ssh

# ---- High-impact opt-ins (all require admin mode too) ---------------------
# Arbitrary command / AppleScript execution and killing processes:
MACOS_ALLOW_EXEC=false
# If set, run_command may only invoke these program names (basename of argv[0]):
# MACOS_COMMAND_ALLOWLIST=git,ls,cat,echo
# Deleting files/folders (to the Trash — recoverable):
MACOS_ALLOW_DELETE=false
# GUI input injection (type / key / click). Needs macOS Accessibility permission,
# and click/move also need `cliclick` (brew install cliclick):
MACOS_ALLOW_INPUT=false

# ---- Safety / limits ------------------------------------------------------
# Validate + log mutating operations without executing them:
MACOS_DRY_RUN=false
# JSON audit line to stderr per guarded operation (default on):
MACOS_AUDIT_LOG=true
# Caps:
# MACOS_MAX_FILE_BYTES=1000000
# MACOS_MAX_OUTPUT_BYTES=100000
# MACOS_COMMAND_TIMEOUT_MS=30000
